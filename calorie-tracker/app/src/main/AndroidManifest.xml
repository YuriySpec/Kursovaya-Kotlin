<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalorieTracker"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".presentation.auth.AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".presentation.auth.RegisterActivity" />
        <activity android:name=".presentation.diary.MainActivity" />
        <activity android:name=".presentation.add.AddEntryActivity" />
        <activity android:name=".presentation.stats.StatsActivity" />
        <activity android:name=".presentation.profile.ProfileActivity" />
    </application>

</manifest>
